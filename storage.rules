rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{t}/{allPaths=**} {
      allow read: if request.auth != null &&
        firestore.exists(
          /databases/(default)/documents/tenants/$(t)/members/$(request.auth.uid)
        );
      allow write: if false;   // signed URLs from Functions only
    }
  }
}
