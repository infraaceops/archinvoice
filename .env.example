# Firebase (required for Google Auth / Firestore path)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Optional: only for invoice PDF / cloud-storage automation.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (web + native)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Choose "cloudflare" for web login through the Worker. Cloudflare auth currently
# supports the web app; keep "firebase" for the current native app flow.
EXPO_PUBLIC_AUTH_PROVIDER=firebase
# Free-tier deployment: Cloudflare Worker API.
EXPO_PUBLIC_API_BASE_URL=https://api.archinvoice.infraaceops.com
EXPO_PUBLIC_APP_DOMAIN=archinvoice.infraaceops.com
