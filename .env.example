# Firebase Authentication (username/password), Firestore, and Functions
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Optional: only for invoice PDF / cloud-storage automation.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Must match USERNAME_AUTH_DOMAIN when provisioning Firebase accounts.
EXPO_PUBLIC_USERNAME_AUTH_DOMAIN=archinvoice.infraaceops.com
EXPO_PUBLIC_APP_DOMAIN=archinvoice.infraaceops.com
