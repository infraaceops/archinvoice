{
  "name": "archinvoice-cloudflare-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create archinvoice",
    "db:migrate:local": "wrangler d1 migrations apply archinvoice --local",
    "db:migrate:remote": "wrangler d1 migrations apply archinvoice --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.154.0"
  }
}
