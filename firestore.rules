rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function authenticatedAccount() {
      return signedIn() &&
        request.auth.token.email is string;
    }
    function uid() { return request.auth.uid; }
    function userPath(userId) {
      return /databases/$(db)/documents/users/$(userId);
    }
    function tenantPath(tenantId) {
      return /databases/$(db)/documents/tenants/$(tenantId);
    }
    function memberPath(tenantId, memberId) {
      return /databases/$(db)/documents/tenants/$(tenantId)/members/$(memberId);
    }
    function activeTenant(tenantId) {
      return exists(tenantPath(tenantId)) &&
        get(tenantPath(tenantId)).data.get('archived', false) == false;
    }
    function memberOf(tenantId) {
      return signedIn() && activeTenant(tenantId) &&
        exists(memberPath(tenantId, uid()));
    }
    function roleOf(tenantId) {
      return get(memberPath(tenantId, uid())).data.role;
    }
    function isAdmin(tenantId) {
      return memberOf(tenantId) && roleOf(tenantId) == 'admin';
    }
    function canWriteInvoices(tenantId) {
      return memberOf(tenantId) && roleOf(tenantId) in ['admin', 'architect'];
    }
    function validBrandingImage(image) {
      return image == null ||
        (image is string &&
         image.size() <= 175000 &&
         image.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }
    function validInitialTenantBilling(tenant, tenantId) {
      return tenant.subscription.keys().hasOnly([
          'status', 'plan', 'pricePkr', 'currentPeriodEnd', 'purchaseToken', 'productId'
        ]) &&
        tenant.subscription.status == 'active' &&
        tenant.subscription.plan == 'core_monthly' &&
        tenant.subscription.pricePkr == 280 &&
        tenant.subscription.currentPeriodEnd > request.time &&
        tenant.subscription.currentPeriodEnd <= request.time + duration.value(14, 'd') &&
        tenant.subscription.purchaseToken == 'trial_' + tenantId &&
        tenant.subscription.productId == 'core_monthly' &&
        tenant.storage.keys().hasOnly([
          'includedGb', 'purchasedGb', 'usedBytes', 'egressMonthBytes',
          'egressMonthKey', 'lastMeteredAt', 'throttled'
        ]) &&
        tenant.storage.includedGb == 1 &&
        tenant.storage.purchasedGb == 0 &&
        tenant.storage.usedBytes == 0 &&
        tenant.storage.egressMonthBytes == 0 &&
        tenant.storage.egressMonthKey is string &&
        tenant.storage.lastMeteredAt == request.time &&
        tenant.storage.throttled == false;
    }
    function validTenantCreate(tenantId) {
      let tenant = request.resource.data;
      let owner = getAfter(userPath(uid())).data;
      let member = getAfter(memberPath(tenantId, uid())).data;
      return authenticatedAccount() &&
        tenant.keys().hasAll([
          'name', 'ceoName', 'logoUrl', 'sealUrl', 'address', 'ntn',
          'currency', 'subscription', 'storage', 'settings', 'createdBy', 'createdAt'
        ]) &&
        tenant.keys().hasOnly([
          'name', 'ceoName', 'logoUrl', 'sealUrl', 'address', 'ntn',
          'currency', 'subscription', 'storage', 'settings', 'createdBy', 'createdAt'
        ]) &&
        tenant.name is string && tenant.name.size() > 0 && tenant.name.size() <= 120 &&
        tenant.ceoName is string && tenant.ceoName.size() > 0 && tenant.ceoName.size() <= 120 &&
        validBrandingImage(tenant.logoUrl) && validBrandingImage(tenant.sealUrl) &&
        tenant.address is string && tenant.address.size() <= 300 &&
        tenant.ntn is string && tenant.ntn.size() <= 40 &&
        tenant.currency == 'PKR' &&
        validInitialTenantBilling(tenant, tenantId) &&
        tenant.settings.keys().hasOnly(['invoiceDefaults']) &&
        tenant.settings.invoiceDefaults.keys().hasOnly(['prefix', 'startAt', 'financialYear']) &&
        tenant.settings.invoiceDefaults.prefix.keys().hasOnly(['architecture', 'interior', 'supervision']) &&
        tenant.settings.invoiceDefaults.startAt.keys().hasOnly(['architecture', 'interior', 'supervision']) &&
        tenant.settings.invoiceDefaults.prefix.architecture == 'ABS' &&
        tenant.settings.invoiceDefaults.prefix.interior == 'INT' &&
        tenant.settings.invoiceDefaults.prefix.supervision == 'SUP' &&
        tenant.settings.invoiceDefaults.startAt.architecture == 1 &&
        tenant.settings.invoiceDefaults.startAt.interior == 1 &&
        tenant.settings.invoiceDefaults.startAt.supervision == 1 &&
        tenant.settings.invoiceDefaults.financialYear is string &&
        tenant.createdBy == uid() &&
        tenant.createdAt == request.time &&
        owner.tenantId == tenantId && owner.role == 'admin' &&
        member.uid == uid() && member.role == 'admin' &&
        member.invitedBy == 'self' &&
        member.email == request.auth.token.email.lower() &&
        member.joinedAt == request.time;
    }
    function validOwnerMemberCreate(tenantId, memberId) {
      let member = request.resource.data;
      let tenant = getAfter(tenantPath(tenantId)).data;
      let owner = getAfter(userPath(uid())).data;
      return authenticatedAccount() && memberId == uid() &&
        member.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'role', 'invitedBy', 'joinedAt']) &&
        member.uid == uid() && member.role == 'admin' &&
        member.invitedBy == 'self' && member.email == request.auth.token.email.lower() &&
        member.joinedAt == request.time &&
        tenant.createdBy == uid() && owner.tenantId == tenantId && owner.role == 'admin';
    }
    function validMemberProfileCreate(userId) {
      let user = request.resource.data;
      let member = getAfter(memberPath(user.tenantId, userId)).data;
      return authenticatedAccount() && userId == uid() &&
        user.keys().hasOnly([
          'uid', 'username', 'displayName', 'email', 'photoUrl', 'tenantId', 'role', 'createdAt', 'updatedAt'
        ]) &&
        user.uid == uid() && user.email == request.auth.token.email.lower() &&
        user.createdAt == request.time &&
        user.role in ['admin', 'architect', 'viewer'] &&
        member.uid == uid() && member.email == user.email &&
        member.role == user.role;
    }
    function validMemberProfileUpdate(userId) {
      let next = request.resource.data;
      return authenticatedAccount() && userId == uid() && resource.data.tenantId == null &&
        next.tenantId is string && activeTenant(next.tenantId) &&
        next.keys().hasOnly([
          'uid', 'username', 'displayName', 'email', 'photoUrl', 'tenantId', 'role', 'createdAt', 'updatedAt'
        ]) &&
        next.uid == uid() && next.email == request.auth.token.email.lower() &&
        next.createdAt == request.time &&
        next.role in ['admin', 'architect', 'viewer'] &&
        getAfter(memberPath(next.tenantId, userId)).data.uid == uid() &&
        getAfter(memberPath(next.tenantId, userId)).data.email == next.email &&
        getAfter(memberPath(next.tenantId, userId)).data.role == next.role;
    }
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if validMemberProfileCreate(userId);
      allow update: if validMemberProfileUpdate(userId);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if memberOf(tenantId);
      allow create: if validTenantCreate(tenantId);
      allow update: if isAdmin(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'ceoName', 'logoUrl', 'sealUrl', 'address', 'ntn', 'settings']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.ceoName is string &&
        request.resource.data.ceoName.size() > 0 &&
        request.resource.data.ceoName.size() <= 120 &&
        validBrandingImage(request.resource.data.logoUrl) &&
        validBrandingImage(request.resource.data.sealUrl) &&
        request.resource.data.address is string &&
        request.resource.data.address.size() <= 300 &&
        request.resource.data.ntn is string &&
        request.resource.data.ntn.size() <= 40;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isAdmin(tenantId) || (memberOf(tenantId) && uid() == memberId);
        allow create: if validOwnerMemberCreate(tenantId, memberId);
        allow delete: if false;
        allow update: if false;
      }

      match /projects/{projectId} {
        allow read: if memberOf(tenantId);
        allow create, update: if canWriteInvoices(tenantId);
        allow delete: if false;
      }

      match /counters/{counterId} {
        allow read: if memberOf(tenantId);
        allow write: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if memberOf(tenantId);
        allow create: if canWriteInvoices(tenantId) &&
          request.resource.data.status == 'draft' &&
          request.resource.data.serial == null;
        allow update: if canWriteInvoices(tenantId) &&
          resource.data.status in ['draft', 'issued'];
        allow delete: if false;
      }

      match /storage_ledger/{entryId} {
        allow read: if isAdmin(tenantId);
        allow write: if false;
      }

      match /billing/{monthId} {
        allow read: if isAdmin(tenantId);
        allow write: if false;
      }
    }
  }
}
